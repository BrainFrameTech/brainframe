+/**
+ * @brief Parse exactly four hex digits at @p s into @p out.
+ *
+ * @return true if all four were hex digits.
+ */
+static bool json_parse_hex4(const char *s, uint32_t *out) {
+    uint32_t v = 0;
+
+    for (int i = 0; i < 4; i++) {
+        char c = s[i];
+
+        v <<= 4;
+        if (c >= '0' && c <= '9') {
+            v |= (uint32_t) (c - '0');
+        } else if (c >= 'a' && c <= 'f') {
+            v |= (uint32_t) (c - 'a' + 10);
+        } else if (c >= 'A' && c <= 'F') {
+            v |= (uint32_t) (c - 'A' + 10);
+        } else {
+            return false;
+        }
+    }
+
+    *out = v;
+    return true;
+}
+
+/**
+ * @brief Decode JSON string escapes in @p s, in place.
+ *
+ * jsmn is a tokenizer: it locates a string's bytes and never decodes what is
+ * inside them. Handing those bytes straight to the caller — the zero-copy
+ * approach in platch_decode_value_json — therefore yields a backslash and an
+ * 'n' where the sender wrote a newline. The encoder on the way back out then
+ * escapes that backslash correctly, so the peer receives a literal backslash
+ * where its newline used to be, and every round trip doubles it. In a text
+ * field that turns a document's newlines into "\n", then "\\n", moving the
+ * caret off by one per newline as it goes, until the editing-state buffer
+ * fills up.
+ *
+ * Decoding only ever shortens: the shortest escape is two bytes for one, and
+ * a surrogate pair is twelve bytes for the four of its UTF-8 encoding. The
+ * result always fits over the original, so the caller's pointer into the
+ * message buffer stays valid and nothing needs freeing.
+ *
+ * An unrecognized escape is kept verbatim, backslash and all, rather than
+ * dropped: silently losing a byte would be the worse failure.
+ */
+static void json_unescape_in_place(char *s) {
+    char *r = s;
+    char *w = s;
+
+    while (*r) {
+        if (*r != '\\') {
+            *w++ = *r++;
+            continue;
+        }
+
+        r++;
+        switch (*r) {
+            case '"': *w++ = '"'; r++; break;
+            case '\\': *w++ = '\\'; r++; break;
+            case '/': *w++ = '/'; r++; break;
+            case 'b': *w++ = '\b'; r++; break;
+            case 'f': *w++ = '\f'; r++; break;
+            case 'n': *w++ = '\n'; r++; break;
+            case 'r': *w++ = '\r'; r++; break;
+            case 't': *w++ = '\t'; r++; break;
+            case 'u': {
+                uint32_t cp;
+
+                if (!json_parse_hex4(r + 1, &cp)) {
+                    // Not a well-formed \uXXXX; keep the backslash and let
+                    // the next iteration copy what follows.
+                    *w++ = '\\';
+                    break;
+                }
+                r += 5;
+
+                // A high surrogate is half a character: take the low one that
+                // the spec requires to follow, if it is there.
+                if (cp >= 0xD800 && cp <= 0xDBFF && r[0] == '\\' && r[1] == 'u') {
+                    uint32_t low;
+
+                    if (json_parse_hex4(r + 2, &low) && low >= 0xDC00 && low <= 0xDFFF) {
+                        cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
+                        r += 6;
+                    }
+                }
+
+                // A surrogate left unpaired cannot be encoded, and passing it
+                // on would make the string invalid UTF-8 for every reader
+                // downstream. U+FFFD is what a decoder is expected to
+                // substitute.
+                if (cp >= 0xD800 && cp <= 0xDFFF) {
+                    cp = 0xFFFD;
+                }
+
+                if (cp < 0x80) {
+                    *w++ = (char) cp;
+                } else if (cp < 0x800) {
+                    *w++ = (char) (0xC0 | (cp >> 6));
+                    *w++ = (char) (0x80 | (cp & 0x3F));
+                } else if (cp < 0x10000) {
+                    *w++ = (char) (0xE0 | (cp >> 12));
+                    *w++ = (char) (0x80 | ((cp >> 6) & 0x3F));
+                    *w++ = (char) (0x80 | (cp & 0x3F));
+                } else {
+                    *w++ = (char) (0xF0 | (cp >> 18));
+                    *w++ = (char) (0x80 | ((cp >> 12) & 0x3F));
+                    *w++ = (char) (0x80 | ((cp >> 6) & 0x3F));
+                    *w++ = (char) (0x80 | (cp & 0x3F));
+                }
+                break;
+            }
+            default:
+                // Unknown escape, or a trailing backslash at end of string.
+                *w++ = '\\';
+                break;
+        }
+    }
+
+    *w = '\0';
+}
+
