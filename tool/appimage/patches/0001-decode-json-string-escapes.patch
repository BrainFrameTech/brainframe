     jsmntok_t *ptoken;
     int result, ok;
@@ -776,11 +902,15 @@ int platch_decode_value_json(char *message, size_t size, jsmntok_t **pptoken, si
 
                 break;
             case JSMN_STRING:;
-                // use zero-copy approach.
+                // Still zero-copy: jsmn locates the string's bytes but never
+                // decodes what is inside it, so the escapes are decoded in
+                // place, over the token they came from.
 
                 message[ptoken->end] = '\0';
                 char *string = message + ptoken->start;
 
+                json_unescape_in_place(string);
+
                 value_out->type = kJsonString;
                 value_out->string_value = string;
 
